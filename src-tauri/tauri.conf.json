{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "myshelf",
  "version": "1.0.0",
  "identifier": "com.myshelf.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "MyShelf",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5QTdGQkYyNENGOEY3RTQKUldUazkvaE04dnVuK1E3VW8wN256L082QjA5TC9kMVpMbFlIbC9Xa3NCZDB6QmdDZmx4VWhmUjAK",
      "endpoints": [
        "https://github.com/dhaniaffa/myshelf_epub_reader/releases/latest/download/latest.json"
      ]
    }
  }
}
